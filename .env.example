# Copiá este archivo a `.env` y completalo. El `.env` real NUNCA se sube al repo.
CLUB_KEY=cambiar-clave-del-club-antes-del-deploy

# --- PostgreSQL ---
POSTGRES_USER=elpodefc
POSTGRES_PASSWORD=elpodefc_dev_local
POSTGRES_DB=elpodefc

# Local: host = localhost, puerto 5433 (el 5432 del host lo usa un postgres nativo de Windows)
# Prod (VPS): host = db, puerto 5432 interno
DATABASE_URL=postgresql://elpodefc:elpodefc_dev_local@localhost:5433/elpodefc

API_PORT=8081
TZ=America/Argentina/Buenos_Aires